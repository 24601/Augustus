#!/bin/bash
# Open, close or inspect the Augustus setup window on tabputer-1 (root only).
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }
case "${1:-status}" in
  open)
    nft list chain inet augexp setup_window | grep -q accept || nft add rule inet augexp setup_window counter name augexp_proxy_ok accept
    systemctl start augproxy.service
    sleep 1
    if ! systemctl is-active --quiet augproxy.service; then
      nft flush chain inet augexp setup_window
      echo "augproxy failed to start; window left CLOSED" >&2; exit 1
    fi
    echo "window OPEN $(date -Is)" | tee -a /srv/aug/admin/windows.log ;;
  close)
    nft flush chain inet augexp setup_window
    systemctl stop augproxy.service || true
    echo "window CLOSED $(date -Is)" | tee -a /srv/aug/admin/windows.log ;;
  status)
    if nft list chain inet augexp setup_window | grep -q accept; then echo "window: OPEN"; else echo "window: closed"; fi
    systemctl is-active augproxy.service || true
    nft list counters table inet augexp ;;
  *) echo "usage: augwindow open|close|status" >&2; exit 2 ;;
esac
